# Frontend (only needed for the GitHub Pages build; leave empty on Netlify)
# Full URL of the deployed function, e.g. https://YOUR-SITE.netlify.app/.netlify/functions/contact
VITE_API_URL=

# Netlify function (set these in Netlify > Site settings > Environment variables)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
# Comma-separated origins allowed to call the function from another domain, e.g. https://USERNAME.github.io
ALLOWED_ORIGINS=
